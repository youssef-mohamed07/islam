# ==========================================
# SANAD (سَنَد) PLATFORM ENVIRONMENT VARIABLES
# ==========================================

NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://sanad_user:sanad_password@localhost:5432/sanad_db?schema=public"

# Redis Cache Connection
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_SECRET="sanad_super_secret_jwt_key_change_in_production"
JWT_REFRESH_SECRET="sanad_super_secret_refresh_jwt_key"
JWT_EXPIRES_IN="1d"

# External Data APIs (Quran Foundation API, Hadith API, etc.)
QURAN_API_BASE_URL="https://api.quran.com/api/v4"
HADITH_API_BASE_URL="https://api.hadith.com/v1"
TAFSIR_API_BASE_URL="https://api.quran-tafsir.com/v1"

# Audio CDN Base
AUDIO_CDN_BASE_URL="https://verses.quran.com"

# AI Retrieval Engine (Sanad AI RAG Layer)
OPENAI_API_KEY="your_openai_api_key_or_compatible_rag_provider"
AI_MODEL_NAME="gpt-4o"

# Admin Dashboard Defaults
ADMIN_DEFAULT_EMAIL="admin@sanad.app"
ADMIN_DEFAULT_PASSWORD="SecureSanadAdminPassword123!"

# Production domain for SEO canonicals / OG urls (sitemap, robots)
NEXT_PUBLIC_SITE_URL="https://www.khairsanad.com"
